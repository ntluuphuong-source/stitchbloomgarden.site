---
import Base from '../layouts/Base.astro';
import ListingCard from '../components/ListingCard.astro';
import FreebieCard from '../components/FreebieCard.astro';
import PostCard from '../components/PostCard.astro';
import Signup from '../components/Signup.astro';
import { SITE, SHOPS, FEATURED_IDS, etsyLink } from '../site.config';
import { getListings } from '../data/listings';
import { getPosts, getFreebies } from '../utils';

const featured = getListings(FEATURED_IDS);
const collage = featured.slice(0, 6);
const freebies = (await getFreebies()).slice(0, 4);
const posts = (await getPosts()).slice(0, 3);
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div>
        <div class="eyebrow">Modern cross stitch patterns</div>
        <h1>Stitch something that makes you smile</h1>
        <p class="lead">
          Sassy black cats, cozy seasons, faith quotes and calm little landscapes. Download free patterns, learn new
          tricks on the blog, and find hundreds more PDF patterns in our Etsy shops.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/free-patterns/">Get free patterns</a>
          <a class="btn btn-ghost" href={etsyLink(SHOPS.StitchBloomGarden.url)} target="_blank" rel="noopener">Visit the Etsy shop</a>
        </div>
      </div>
      <div class="hero-collage" aria-hidden="true">
        {collage.map((l) => <img src={l.image} alt="" width="200" height="200" />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Free patterns</h2>
        <a class="text-link" href="/free-patterns/">See all free patterns →</a>
      </div>
      {freebies.length ? (
        <div class="grid">{freebies.map((f) => <FreebieCard freebie={f} />)}</div>
      ) : (
        <div class="empty">
          <h3>The first free patterns are on the way</h3>
          <p>Sign up below and we'll send them to you as soon as they're ready.</p>
        </div>
      )}
    </div>
  </section>

  <section class="section" style="background: var(--surface); border-block: 1px solid var(--line);">
    <div class="wrap">
      <div class="section-head">
        <h2>Stitchers' favorites</h2>
        <a class="text-link" href="/shop/">Browse all patterns →</a>
      </div>
      <div class="grid">{featured.map((l) => <ListingCard listing={l} />)}</div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>From the blog</h2>
          <a class="text-link" href="/blog/">All articles →</a>
        </div>
        <div class="grid grid-wide">{posts.map((p) => <PostCard post={p} fallbackImage={getListings(p.data.patterns)[0]?.image} />)}</div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap"><Signup /></div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Our Etsy shops</h2></div>
      <div class="shops">
        {Object.values(SHOPS).map((shop) => (
          <div class="shop-card">
            <h3>{shop.name}</h3>
            <p>{shop.blurb}</p>
            <a class="btn btn-sage" href={etsyLink(shop.url)} target="_blank" rel="noopener">Visit {shop.name}</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
